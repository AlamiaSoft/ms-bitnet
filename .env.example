# BitNet Docker Environment Configuration

# Host port mapping for OpenAI-compatible API (http://localhost:8080)
BITNET_HOST_PORT=8080

# Path to model GGUF file inside container (/models maps to host ./models)
BITNET_MODEL=/models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf

# Number of CPU threads to allocate for inference
BITNET_THREADS=4

# Context window size
BITNET_CTX_SIZE=2048

# Sampling temperature
BITNET_TEMP=0.7

# Repetition penalty (prevents degenerative loops in base/1-bit models)
BITNET_REPEAT_PENALTY=1.15

# Top-P sampling
BITNET_TOP_P=0.9

# Min-P sampling
BITNET_MIN_P=0.05

# Jinja chat template (chatml, llama3, or default)
BITNET_CHAT_TEMPLATE=chatml

# Maximum tokens to predict
BITNET_N_PREDICT=4096
